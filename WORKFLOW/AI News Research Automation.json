        "messages": {
          "values": [
            {
              "content": "=You are an AI News Research Assistant.\n\nAnalyze the following article.\n\nTitle:\n{{ $json.title }}\n\nDescription:\n{{ $json.description }}\n\nContent:\n{{ $json.content }}\n\nSource:\n{{ $json.source.name }}\n\nPublished Date:\n{{ $json.publishedAt }}\n\nReturn ONLY valid JSON using this structure:\n{ \"summary\": \"\", \"key_takeaway\": \"\", \"category\": \"\", \"linkedin_score\": 0 }\n\nRules:\n- Summary must be 2-3 sentences.\n- key_takeaway should be one sentence.\n- Category must be exactly one of: AI Product, AI Research, Funding, Open Source, Business.\n- linkedin_score must be an integer between 1 and 10."
            }
          ]
        },
        "options": {
          "maxTokens": 1024
        }
      },
      "id": "3b1af1b3-fa71-4782-8e72-927dc95818cd",
      "name": "Analyze Article (Claude)",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        672,
        96
      ],
      "credentials": {
        "anthropicApi": {
          "id": "JDRzPg3y5vllnco8",
          "name": "Anthropic account 2"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sourceItems = $('Split Articles').all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const aj = items[i].json || {};\n  const article = (sourceItems[i] && sourceItems[i].json) ? sourceItems[i].json : {};\n  // Extract the model text from whatever shape the node returned\n  let raw = '';\n  if (typeof aj.content === 'string') { raw = aj.content; }\n  else if (Array.isArray(aj.content) && aj.content[0] && typeof aj.content[0].text === 'string') { raw = aj.content[0].text; }\n  else if (typeof aj.text === 'string') { raw = aj.text; }\n  else if (aj.message && typeof aj.message.content === 'string') { raw = aj.message.content; }\n  else if (typeof aj.message === 'string') { raw = aj.message; }\n  // Pull the JSON object out of the text (handles ```json fences and extra prose)\n  let parsed = {};\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start !== -1 && end !== -1 && end > start) {\n    try { parsed = JSON.parse(raw.substring(start, end + 1)); } catch (err) { parsed = {}; }\n  }\n  let score = parseInt(parsed.linkedin_score, 10);\n  if (isNaN(score)) { score = 0; }\n  out.push({ json: {\n    \"Title\": article.title || '',\n    \"Source\": (article.source && article.source.name) ? article.source.name : '',\n    \"Published Date\": article.publishedAt || '',\n    \"Summary\": parsed.summary || '',\n    \"Key Takeaway\": parsed.key_takeaway || '',\n    \"Category\": parsed.category || '',\n    \"LinkedIn Worthiness Score\": score,\n    \"Article URL\": article.url || '',\n  } });\n}\nreturn out;"
      },
